<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Theme.AdamAsmacaOyunu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".SonucActivity">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/durumTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/chalk_font"
        android:gravity="center"
        android:textColor="@color/metin_ana"
        android:textSize="32sp"
        android:textStyle="bold"
        android:shadowColor="@color/tebesir_golge"
        android:shadowDx="1.5"
        android:shadowDy="2"
        android:shadowRadius="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="🎉 SEVİYE 1 GEÇİLDİ!" />

    <ImageView
        android:id="@+id/sonucResim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/sonuc_resmi_desc"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/bulunacakKelimeTxt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/durumTxt"
        app:srcCompat="@drawable/adam0" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/bulunacakKelimeTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/chalk_font"
        android:gravity="center"
        android:textColor="@color/metin_vurgu"
        android:textSize="28sp"
        android:textStyle="bold"
        android:shadowColor="@color/tebesir_golge"
        android:shadowDx="1"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintBottom_toTopOf="@id/carkBonusBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Kahramanmaraş" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/carkBonusBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/chalk_font"
        android:paddingVertical="12dp"
        android:text="@string/cark_cevir"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:visibility="gone"
        app:backgroundTint="@color/tahta_kahve"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@id/tektatOynaBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tektatOynaBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/chalk_font"
        android:paddingVertical="12dp"
        android:text="@string/tekrar_oyna"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:backgroundTint="@color/tahta_yesili"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@id/cikisBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cikisBtn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chalk_font"
        android:paddingVertical="12dp"
        android:text="@string/cikis"
        android:textColor="@color/metin_ana"
        android:textSize="18sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/buton_outlined_kenarlik" />

</androidx.constraintlayout.widget.ConstraintLayout>