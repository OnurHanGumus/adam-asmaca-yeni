<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/carkKapatBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kapat"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/tus_yazi_pasif" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/carkBaslikTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/cark_baslik"
            android:textColor="@color/tahta_kahve"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/carkKapatBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/carkAciklamaTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/tus_yazi_pasif"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/carkBaslikTxt"
            tools:text="Tebrikler! Seviye 5 tamamlandı! Çarkı çevir ve bonus altınları kazan!" />

        <!-- Wheel Container -->
        <FrameLayout
            android:id="@+id/carkFrame"
            android:layout_width="260dp"
            android:layout_height="276dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/carkAciklamaTxt">

            <!-- The Spinning Wheel -->
            <ImageView
                android:id="@+id/carkTekerlek"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="bottom|center_horizontal"
                android:contentDescription="@string/cark_baslik"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/cark_tekerlek" />

            <!-- The Top Arrow Pointer pointing down -->
            <ImageView
                android:id="@+id/carkOk"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/cark_baslik"
                android:elevation="6dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/cark_ok" />

        </FrameLayout>

        <!-- Result / Status Text -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/carkSonucTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/tahta_yesili"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/carkFrame"
            tools:text="🎉 Tebrikler! 120 Altın Kazandın!" />

        <!-- Spin / Collect Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/carkCevirBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingVertical="12dp"
            android:text="@string/cark_cevir"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/tahta_yesili"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/carkSonucTxt" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
