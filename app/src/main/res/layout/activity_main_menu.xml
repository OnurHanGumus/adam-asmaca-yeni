<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Theme.AdamAsmacaOyunu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".MainMenuActivity">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/appTitleTxt"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_name"
        android:textColor="@color/tahta_kahve"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnAyarlar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/badge_bg"
        android:contentDescription="@string/ayarlar"
        android:padding="9dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/appTitleTxt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/appTitleTxt"
        app:srcCompat="@drawable/ic_settings" />

    <LinearLayout
        android:id="@+id/statusHeaderLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTitleTxt">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/coinTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textColor="@color/tahta_kahve"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="🪙 50" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/canTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textColor="@color/tahta_kahve"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="❤️ 3/3" />

    </LinearLayout>

    <ImageView
        android:id="@+id/adamOzgurImg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/sonuc_resmi_desc"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/btnAnaOyun"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusHeaderLayout"
        app:srcCompat="@drawable/adam_ozgur" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnaOyun"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingVertical="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/tahta_yesili"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnPratik"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Ana Oyun (Seviye 1)" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPratik"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingVertical="10dp"
        android:textColor="@color/tahta_kahve"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/tahta_kahve"
        tools:text="Pratik Modu" />

</androidx.constraintlayout.widget.ConstraintLayout>
